# Copy this file to .env.local and fill in your values.

# MongoDB connection string. Leave empty to run in in-memory Mock Mode.
#   Local  :  mongodb://127.0.0.1:27017/nuvosid
#   Atlas  :  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/nuvosid
MONGODB_URI=

# Secret used to sign auth JWTs. Use a long random string in production.
JWT_SECRET=change_me_to_a_long_random_string

# The API is built into this Next app (app/api/*). Leave empty.
# Only set this if you use the standalone Express server in server/.
NEXT_PUBLIC_API_URL=

# Razorpay — leave EMPTY to run the dummy checkout. Fill these in later to go
# live: the enroll flow switches to the real Razorpay automatically.
#   Get keys from Razorpay Dashboard → Settings → API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Same public key id, exposed to the browser checkout (usually the KEY_ID value).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
